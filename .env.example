# Copy to .env (for local runs) or set as a GitHub Actions secret.

# Discord webhook the alert posts to. Create one in: Server Settings ->
# Integrations -> Webhooks. Without it, the alert just prints to stdout.
DISCORD_WEBHOOK_URL=

# Optional overrides:
# DC_ALERT_QUERIES="Bay Area data center;San Jose data center"   # ';'-separated
# DC_ALERT_REGION="SF Bay Area"
# DC_ALERT_LOOKBACK_HOURS=48
# DC_ALERT_MAX_ITEMS=6
